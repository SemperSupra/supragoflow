# syntax=docker/dockerfile:1
ARG DEBIAN_BASE=debian:trixie-slim
FROM ${DEBIAN_BASE}

ARG GO_VERSION=1.25.7
ARG GOLANGCI_LINT_VERSION=v1.64.8
ARG GOVULNCHECK_VERSION=v1.1.4
ARG GOTESTSUM_VERSION=v1.13.0
ARG AIR_VERSION=v1.61.5
ARG TARGETARCH

RUN apt-get update && apt-get install -y --no-install-recommends       ca-certificates git wget bash jq     && rm -rf /var/lib/apt/lists/*

RUN set -eux;     case "${TARGETARCH}" in       amd64) GOARCH=amd64 ;;       arm64) GOARCH=arm64 ;;       *) echo "unsupported TARGETARCH=${TARGETARCH}" >&2; exit 1 ;;     esac;     cd /tmp;     wget -q "https://dl.google.com/go/go${GO_VERSION}.linux-${GOARCH}.tar.gz";     wget -q "https://dl.google.com/go/go${GO_VERSION}.linux-${GOARCH}.tar.gz.sha256";     echo "$(cat "go${GO_VERSION}.linux-${GOARCH}.tar.gz.sha256")  go${GO_VERSION}.linux-${GOARCH}.tar.gz" | sha256sum -c -;     tar -C /usr/local -xzf "go${GO_VERSION}.linux-${GOARCH}.tar.gz";     rm -f /tmp/go*.tar.gz /tmp/go*.sha256

ENV PATH="/usr/local/go/bin:${PATH}:/go/bin"     GOPATH="/go"     GOCACHE="/go-cache"     GOMODCACHE="/go/pkg/mod"     CGO_ENABLED=0

RUN set -eux; \
    groupadd -g 10001 supragoflow; \
    useradd -m -u 10001 -g 10001 -s /usr/sbin/nologin supragoflow; \
    mkdir -p /go /go-cache /work; \
    chown -R 10001:10001 /go /go-cache /work

# Install golangci-lint (pinned, built from source to match GO_VERSION)
RUN set -eux;     go install github.com/golangci/golangci-lint/v2/cmd/golangci-lint@${GOLANGCI_LINT_VERSION};     golangci-lint version

# Install govulncheck (pinned)
RUN set -eux;     go install golang.org/x/vuln/cmd/govulncheck@${GOVULNCHECK_VERSION};     govulncheck -h >/dev/null

# Optional nicer test output (pinned)
RUN set -eux;     go install gotest.tools/gotestsum@${GOTESTSUM_VERSION};     gotestsum --version >/dev/null || true

# Install air for live reloading
RUN set -eux;     go install github.com/air-verse/air@${AIR_VERSION};     air -v >/dev/null || true

WORKDIR /work
USER 10001:10001
CMD ["bash", "-lc", "go version && golangci-lint version && echo supragoflow-dev ready"]
